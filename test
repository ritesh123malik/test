        window.renderFeed = () => {

            const container = document.getElementById('feedGrid');

            const skeleton = document.getElementById('feedSkeleton');

            const search = document.getElementById('feedSearch').value.toLowerCase();

            const filter = document.getElementById('feedFilter').value;

            const sort = document.getElementById('feedSort').value;

            

            skeleton.classList.remove('hidden-ui');

            container.innerHTML = "";

            

            setTimeout(() => {

                skeleton.classList.add('hidden-ui');

                const totalResolved = globalData.filter(i => i.status === 'Resolved').length;

                const totalItems = globalData.length;

                const activeItems = globalData.filter(i => i.status !== 'Resolved').length;

                const uniqueUsers = [...new Set(globalData.map(i => i.email))].length;

                const rate = totalItems > 0 ? ((totalResolved / totalItems) * 100).toFixed(1) : 0;

                

                document.getElementById('stat_recovered').innerText = totalResolved;

                document.getElementById('stat_rate').innerText = rate + "%";

                document.getElementById('stat_active').innerText = activeItems;

                document.getElementById('stat_users').innerText = uniqueUsers;



                let filtered = globalData.filter(item => {

                    const iName = item.item ? item.item.toLowerCase() : "";

                    const iDesc = item.desc ? item.desc.toLowerCase() : "";

                    const matchesSearch = (iName.includes(search) || iDesc.includes(search));

                    const matchesType = (filter === "All" || item.type === filter);

                    const matchesCategory = (currentCategory === 'All' || iName.includes(currentCategory.toLowerCase()));

                    return matchesSearch && matchesType && matchesCategory && item.status !== 'Resolved';

                });



                if (sort === 'recent') { 

                    filtered.sort((a, b) => new Date(b.date) - new Date(a.date)); 

                    renderSortedItems(filtered);

                } else if (sort === 'match') { 

                    filtered.sort((a, b) => { 

                        const scoreA = calculateSimilarity(a.item + " " + a.desc, search); 

                        const scoreB = calculateSimilarity(b.item + " " + b.desc, search); 

                        return scoreB - scoreA; 

                    }); 

                    renderSortedItems(filtered);

                } else if (sort === 'distance') {

                    // FIX #4: Async Distance Sort

                    if (navigator.geolocation) {

                        navigator.geolocation.getCurrentPosition((position) => {

                            const userLat = position.coords.latitude;

                            const userLng = position.coords.longitude;

                            

                            filtered.sort((a, b) => {

                                const distA = a.lat && a.lng ? getDistanceFromLatLonInKm(userLat, userLng, parseFloat(a.lat), parseFloat(a.lng)) : 999999;

                                const distB = b.lat && b.lng ? getDistanceFromLatLonInKm(userLat, userLng, parseFloat(b.lat), parseFloat(b.lng)) : 999999;

                                return distA - distB;

                            });

                            

                            renderSortedItems(filtered);

                        }, (error) => {

                            window.showToast("Enable location for distance sorting", "warning");

                            renderSortedItems(filtered); // Render anyway without sort

                        });

                        return; // Halt standard sync render, wait for async callback

                    } else {

                        renderSortedItems(filtered);

                    }

                }

            }, 800);

        };



        function getTimeAgo(date) {

            const seconds = Math.floor((new Date() - date) / 1000);

            const intervals = { year: 31536000, month: 2592000, week: 604800, day: 86400, hour: 3600, minute: 60 };

            for (let key in intervals) { const interval = Math.floor(seconds / intervals[key]); if (interval >= 1) { return interval + ' ' + key + (interval > 1 ? 's' : '') + ' ago'; } }

            return 'Just now';

        }



