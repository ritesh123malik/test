    <style>
        /* AI Chat Scrollbar */
#aiMessages::-webkit-scrollbar { width: 4px; }
#aiMessages::-webkit-scrollbar-thumb { background: rgba(139, 92, 246, 0.3); border-radius: 2px; }

/* User Message Bubble */
.msg-user {
    align-self: flex-end;
    background: linear-gradient(135deg, #3b82f6, #8b5cf6);
    color: white;
    border-radius: 1rem 1rem 0 1rem;
    padding: 0.75rem;
    font-size: 0.75rem;
    max-width: 85%;
    box-shadow: 0 4px 15px rgba(59, 130, 246, 0.3);
    margin-left: auto;
    word-wrap: break-word;
}

/* AI Message Bubble */
.msg-ai {
    align-self: flex-start;
    background: rgba(255, 255, 255, 0.05);
    color: #cbd5e1;
    border-radius: 1rem 1rem 1rem 0;
    padding: 0.75rem;
    font-size: 0.75rem;
    max-width: 85%;
    border: 1px solid rgba(255, 255, 255, 0.05);
    display: flex;
    gap: 0.5rem;
    word-wrap: break-word;
}

/* Typing Animation */
.typing-dot {
    width: 4px; height: 4px; background: #60a5fa; border-radius: 50%;
    animation: typing 1.4s infinite ease-in-out both;
}
.typing-dot:nth-child(1) { animation-delay: -0.32s; }
.typing-dot:nth-child(2) { animation-delay: -0.16s; }

@keyframes typing {
    0%, 80%, 100% { transform: scale(0); }
    40% { transform: scale(1); }
}

        body { 

            background-color: #020617; 

            color: #f8fafc; 

            overflow-x: hidden; 

            -webkit-tap-highlight-color: transparent; 

        }



        /* Glass Effects */

        .glass-panel {

            background: rgba(15, 23, 42, 0.65);

            backdrop-filter: blur(20px);

            -webkit-backdrop-filter: blur(20px);

            border: 1px solid rgba(255, 255, 255, 0.08);

            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);

        }

        

        .glass-input {

            background: rgba(255, 255, 255, 0.03)!important;

            border: 1px solid rgba(255, 255, 255, 0.1)!important;

            color: white!important;

            transition: all 0.3s ease;

        }

        .glass-input:focus {

            background: rgba(255, 255, 255, 0.08)!important;

            border-color: #8b5cf6!important;

            outline: none;

            box-shadow: 0 0 0 3px rgba(139, 92, 246, 0.3);

        }



        /* Hero Gradient */

        .hero-gradient-text {

            background: linear-gradient(135deg, #fff 0%, #a78bfa 50%, #22d3ee 100%);

            -webkit-background-clip: text;

            -webkit-text-fill-color: transparent;

            animation: shimmer 3s linear infinite;

            background-size: 200% 100%;

        }



        /* Mesh Background */

        .mesh-bg { 

            position: fixed; 

            top: 0; 

            left: 0; 

            width: 100vw; 

            height: 100vh; 

            z-index: -1; 

            overflow: hidden; 

            background: #020617; 

        }

        .mesh-orb { 

            position: absolute; 

            border-radius: 50%; 

            filter: blur(100px); 

            opacity: 0.4; 

        }



        /* Utility Classes */

        .hidden-ui { display: none!important; }

        

        .btn-primary {

            background: linear-gradient(135deg, #7c3aed, #22d3ee);

            position: relative; 

            overflow: hidden; 

            transition: all 0.3s;

        }

        .btn-primary:hover { 

            box-shadow: 0 0 40px rgba(124, 58, 237, 0.6); 

            transform: translateY(-2px) scale(1.02); 

        }

        .btn-primary::before {

            content: '';

            position: absolute;

            top: 0;

            left: -100%;

            width: 100%;

            height: 100%;

            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);

            transition: left 0.5s;

        }

        .btn-primary:hover::before {

            left: 100%;

        }

        

        /* Skeleton Loader */

        .skeleton {

            background: linear-gradient(90deg, rgba(255,255,255,0.03) 25%, rgba(255,255,255,0.08) 50%, rgba(255,255,255,0.03) 75%);

            background-size: 200% 100%;

            animation: shimmer 2s infinite;

            border-radius: 0.5rem;

        }



        /* Card Hover Effects */

        .card-hover {

            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);

        }

        .card-hover:hover {

            transform: translateY(-8px) scale(1.02);

            box-shadow: 0 20px 60px rgba(139, 92, 246, 0.3);

        }



        /* Progress Bar */

        .progress-bar {

            position: relative;

            overflow: hidden;

        }

        .progress-bar::before {

            content: '';

            position: absolute;

            top: 0;

            left: 0;

            height: 100%;

            background: linear-gradient(90deg, #7c3aed, #22d3ee);

            transition: width 0.5s ease;

        }



        /* Badge Glow */

        .badge-glow {

            animation: glow 2s ease-in-out infinite alternate;

        }



        /* Map Styles */

        .leaflet-container { 

            z-index: 0; 

            border-radius: 1rem; 

            font-family: 'Plus Jakarta Sans'; 

            background: #f0f0f0!important; 

        }

        .leaflet-popup-content-wrapper {

            background: rgba(15, 23, 42, 0.95);

            backdrop-filter: blur(10px);

            color: white;

            border: 1px solid rgba(255,255,255,0.1);

            border-radius: 1rem;

        }

        .leaflet-popup-tip { background: rgba(15, 23, 42, 0.95); }

        

        .custom-pin { position: relative; width: 20px; height: 20px; }

        .pin-inner { 

            width: 16px; 

            height: 16px; 

            background: #22d3ee; 

            border: 2px solid white; 

            border-radius: 50%; 

            position: absolute; 

            top: 2px; 

            left: 2px; 

            z-index: 10; 

            box-shadow: 0 0 15px #22d3ee; 

        }

        .pin-pulse { 

            position: absolute; 

            top: -2px; 

            left: -2px; 

            width: 24px; 

            height: 24px; 

            background: rgba(34, 211, 238, 0.4); 

            border-radius: 50%; 

            animation: pulse-ring 2s infinite; 

        }

        @keyframes pulse-ring { 

            0% { transform: scale(0.8); opacity: 1; } 

            100% { transform: scale(2.5); opacity: 0; } 

        }



        /* Toggle Switch */

        .toggle-checkbox:checked { right: 0; border-color: #68D391; }

        .toggle-checkbox:checked + .toggle-label { background-color: #68D391; }



        /* Achievement Badge */

        .achievement-badge {

            position: relative;

            overflow: hidden;

        }

        .achievement-badge::after {

            content: '✓';

            position: absolute;

            top: -2px;

            right: -2px;

            background: #10b981;

            color: white;

            font-size: 10px;

            width: 18px;

            height: 18px;

            border-radius: 50%;

            display: flex;

            align-items: center;

            justify-content: center;

            border: 2px solid #020617;

        }



        /* Mobile Bottom Nav */

        @media (max-width: 768px) {

            .mobile-nav {

                position: fixed;

                bottom: 0;

                left: 0;

                right: 0;

                z-index: 50;

                transform: translateY(0);

                transition: transform 0.3s;

            }

            .mobile-nav.hidden {

                transform: translateY(100%);

            }

        }



        /* Smooth Scrollbar */

        ::-webkit-scrollbar {

            width: 8px;

            height: 8px;

        }

        ::-webkit-scrollbar-track {

            background: rgba(15, 23, 42, 0.5);

        }

        ::-webkit-scrollbar-thumb {

            background: rgba(139, 92, 246, 0.5);

            border-radius: 4px;

        }

        ::-webkit-scrollbar-thumb:hover {

            background: rgba(139, 92, 246, 0.8);

        }



        /* Loading Spinner */

        .spinner {

            border: 3px solid rgba(255, 255, 255, 0.1);

            border-top: 3px solid #8b5cf6;

            border-radius: 50%;

            width: 40px;

            height: 40px;

            animation: spin 1s linear infinite;

        }

        @keyframes spin {

            0% { transform: rotate(0deg); }

            100% { transform: rotate(360deg); }

        }

        

        .achievement-item.locked { opacity: 0.4; }

        .achievement-item.unlocked { animation: scaleIn 0.5s ease-out; }

        

        .category-pill.active {

            background: linear-gradient(135deg, #7c3aed, #22d3ee);

            color: white;

            border-color: transparent;

        }

    </style>

