// 🔍 DETECT LOCATION FROM TEXT
function detectLocation(text) {
    const lowerText = text.toLowerCase();
    
    // Check for exact matches first
    for (let [keyword, location] of Object.entries(CAMPUS_LOCATIONS)) {
        if (lowerText.includes(keyword)) {
            return location;
        }
    }
    
    // Check for common phrases
    const locationPatterns = [
        /(?:near|at|in|by|outside|inside)\s+(?:the\s+)?(\w+(?:\s+\w+)?)/gi
    ];
    
    for (let pattern of locationPatterns) {
        const matches = lowerText.matchAll(pattern);
        for (let match of matches) {
            const place = match[1].toLowerCase();
            if (CAMPUS_LOCATIONS[place]) {
                return CAMPUS_LOCATIONS[place];
            }
        }
    }
    
    return null;
}

async function fetchGroq(userQuery) {
    const url = "https://api.groq.com/openai/v1/chat/completions";
    
   const systemPrompt = `
You are the Navigator AI for LNMIIT Lost & Found Portal.
