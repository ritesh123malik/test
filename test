                });

                

                const data = await response.json();

                if (data.result !== "success") throw new Error(data.message || "AI Analysis Failed");

                

                // Extract results from proxy response

                // Structure: data.data.responses[0]

                const result = data.data.responses[0];

                let detectedItems = [];

                

                if (result.labelAnnotations) {

                    const ignored = [ "Rectangle", "Product", "Material", "Font", "Electric blue", "Magenta", "Red", "Blue", "Green", "Black", "White", "Yellow", "Orange", "Pink" ];

                    result.labelAnnotations.forEach(label => { if (label.score > 0.5 && !ignored.includes(label.description)) { detectedItems.push(label.description); } });

                }

                if (result.fullTextAnnotation) {

                    const cleanText = result.fullTextAnnotation.text.replace(/\\n/g, " ").trim();

                    if (cleanText.length > 3) detectedItems.push(`Text: "${cleanText.substring(0, 30)}..."`);

                }

                

                if (detectedItems.length > 0) {

                    const currentDesc = document.getElementById('r_desc');

                    const finalTags = detectedItems.slice(0, 5).join(', ');

                    const newInfo = `[AI: ${finalTags}]`;

                    if (!currentDesc.value.includes(newInfo)) currentDesc.value = currentDesc.value + (currentDesc.value ? " " : "") + newInfo;

                    status.innerHTML = `<div class="flex items-center gap-2"><i class="fa-solid fa-check-circle text-green-400"></i><span>✨ Identified: <strong>${detectedItems[0]}</strong></span></div>`;

                } else { 

                    status.innerHTML = `<span class="text-slate-400">Image scanned. Try a clearer photo.</span>`; 

                }

                window.updateFormProgress();

            } catch (error) { 

                console.error("AI Error:", error); 

                status.innerHTML = `<div class="flex items-center gap-2"><i class="fa-solid fa-triangle-exclamation text-red-400"></i><span>AI unavailable (Using Manual Mode)</span></div>`; 

            }

        };



        window.unlockAchievement = (index, name) => {

            const items = document.querySelectorAll('.achievement-item');

            if (items[index] && !items[index].classList.contains('unlocked')) {

                items[index].classList.remove('locked');

                items[index].classList.add('unlocked', 'achievement-badge');

                items[index].querySelector('i').classList.remove('text-slate-700');

                items[index].querySelector('i').classList.add('text-electric-400');

                window.showToast(`🏆 Achievement Unlocked: ${name}!`, "success");

                confetti({ particleCount: 100, spread: 70, origin: { y: 0.6 } });

                const count = document.querySelectorAll('.achievement-item.unlocked').length;

                document.getElementById('achievementCount').innerText = count;

            }

        };



        window.updateLevelProgress = (points) => {

            const levels = [0, 50, 150, 300, 500, 800, 1200];

            let level = 1;

            for (let i = 0; i < levels.length; i++) { if (points >= levels[i]) level = i + 1; }

            document.getElementById('userLevel').innerText = level;

            const nextLevel = level < levels.length ? levels[level] : levels[levels.length - 1];

            const currentLevelMin = levels[level - 1];

            const progress = ((points - currentLevelMin) / (nextLevel - currentLevelMin)) * 100;

            document.getElementById('levelProgress').style.width = Math.min(progress, 100) + '%';

            document.getElementById('nextLevelText').innerText = `Next: ${nextLevel} points`;

            const ring = document.getElementById('progressRing');

            if(ring) { const offset = 283 - (283 * progress / 100); ring.style.strokeDashoffset = offset; }

        };



        // FIX #5: Logic to actually add/remove the heatmap layer

        window.toggleHeatmap = () => {

            if (!adminMapInstance) {

                // If toggled before map load

                initAdminMap();

                window.showToast("Initializing Map...", "info");

                return;

            }

            if (!heatmapLayer) {

                window.showToast("No heatmap data available", "warning");

                return;

            }

            if (heatmapVisible) {

                adminMapInstance.removeLayer(heatmapLayer);

                heatmapVisible = false;

                window.showToast("Heatmap hidden", "info");

            } else {

                heatmapLayer.addTo(adminMapInstance);

                heatmapVisible = true;

                window.showToast("Heatmap shown", "success");

            }

        };

        

        window.refreshAnalytics = () => { window.fetchData(); window.renderAnalytics(); window.showToast("Analytics refreshed", "success"); };

        window.clearLogs = () => { if (confirm("Clear all activity logs?")) { window.showToast("Logs cleared", "success"); } };
        // Initialize AI model on app load
if(currentUser) {
    setTimeout(() => {
        loadAIModel().then(() => {
            indexExistingImages();
        });
    }, 3000);
}
    </script>
    <div class="fixed bottom-6 right-6 z-[100] flex flex-col items-end gap-4">
    <div id="aiChatWindow" class="hidden-ui w-80 md:w-96 h-[500px] glass-panel rounded-3xl flex flex-col overflow-hidden border border-electric-500/30 shadow-2xl animate-scale-in origin-bottom-right transition-all duration-300">
        <div class="p-4 border-b border-white/10 bg-electric-600/20 flex justify-between items-center backdrop-blur-md">
            <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-full bg-gradient-to-br from-blue-500 to-purple-500 flex items-center justify-center shadow-lg shadow-blue-500/30">
                    <i class="fa-solid fa-sparkles text-white text-xs"></i>
                </div>
                <div>
                    <h3 class="text-sm font-bold text-white">Gemini Assistant</h3>
                    <p class="text-[10px] text-electric-300">Smart Navigator</p>
                </div>
            </div>
            <button onclick="window.toggleAI()" class="text-slate-400 hover:text-white transition hover:rotate-90 duration-300"><i class="fa-solid fa-times"></i></button>
        </div>

        <div id="aiMessages" class="flex-1 overflow-y-auto p-4 space-y-4 scroll-smooth">
            <div class="flex gap-3 animate-fade-up">
                <div class="w-6 h-6 rounded-full bg-white/10 flex-shrink-0 flex items-center justify-center"><i class="fa-solid fa-robot text-[10px]"></i></div>
                <div class="bg-white/10 p-3 rounded-2xl rounded-tl-none text-xs text-slate-200 leading-relaxed max-w-[85%] border border-white/5 shadow-sm">
                    Hello! I can navigate the portal for you. Try saying <b>"I found a wallet"</b> or <b>"Show me the map"</b>.
                </div>
            </div>
        </div>

        <div class="p-4 border-t border-white/10 bg-midnight/50 backdrop-blur-sm">
            <form onsubmit="window.handleAIMessage(event)" class="relative">
                <input type="text" id="aiInput" placeholder="Ask Gemini..." class="w-full pl-4 pr-12 py-3 glass-input rounded-xl text-xs focus:ring-2 focus:ring-electric-500/50 transition text-white placeholder-slate-500" autocomplete="off">
                <button type="submit" id="aiSendBtn" class="absolute right-2 top-2 w-8 h-8 bg-gradient-to-br from-electric-500 to-blue-500 hover:from-electric-400 hover:to-blue-400 text-white rounded-lg flex items-center justify-center transition shadow-lg transform hover:scale-105">
                    <i class="fa-solid fa-paper-plane text-xs"></i>
                </button>
            </form>
            <div class="text-[9px] text-center text-slate-600 mt-2 font-mono">Powered by Google Gemini 1.5 Flash</div>
        </div>
    </div>

    <button onclick="window.toggleAI()" class="w-14 h-14 rounded-full btn-primary shadow-2xl flex items-center justify-center group hover:scale-110 transition duration-300 border-2 border-white/20 relative">
        <i class="fa-brands fa-google text-xl text-white group-hover:animate-bounce"></i>
        <span class="absolute -top-1 -right-1 w-3 h-3 bg-green-500 rounded-full border-2 border-midnight animate-pulse"></span>
    </button>
</div>
